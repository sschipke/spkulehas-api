<tr>
  <td
    align="center"
    style="padding: 20px 32px; background-color: {{headerColor}};"
  >
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
      <tr>
        <td align="center">
          {{#if logoUrl}}
            <img
              src="{{logoUrl}}"
              alt="{{siteName}}"
              width="32"
              height="32"
              style="display: block; margin: 0 auto 8px;"
            />
          {{/if}}
          <a
            href="{{siteUrl}}"
            style="font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 20px; font-weight: 700; color: #ffffff; text-decoration: none;"
          >
            {{siteName}}
          </a>
        </td>
      </tr>
    </table>
  </td>
</tr>
