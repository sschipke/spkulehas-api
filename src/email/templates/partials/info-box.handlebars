<table
  role="presentation"
  width="100%"
  cellspacing="0"
  cellpadding="0"
  border="0"
  style="margin: 16px 0; background-color: {{#if backgroundColor}}{{backgroundColor}}{{else}}#f5f5f5{{/if}}; border-left: 4px solid {{#if accentColor}}{{accentColor}}{{else}}{{primaryColor}}{{/if}};"
>
  <tr>
    <td style="padding: 12px 16px;">
      <p
        style="margin: 0; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 14px; line-height: 1.6; color: {{#if textColor}}{{textColor}}{{else}}#424242{{/if}};"
      >
        {{{content}}}
      </p>
    </td>
  </tr>
</table>
