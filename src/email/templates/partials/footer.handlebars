<tr>
  <td
    style="padding: 20px 32px; background-color: #fafafa; border-top: 1px solid #e0e0e0;"
  >
    <p
      style="margin: 0 0 8px; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 14px; line-height: 1.5; color: #757575; text-align: center;"
    >
      Questions? Contact us at
      <a href="mailto:{{contactEmail}}" style="color: {{primaryColor}}; text-decoration: underline;">{{contactEmail}}</a>
    </p>
    <p
      style="margin: 0; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 12px; line-height: 1.5; color: #9e9e9e; text-align: center;"
    >
      &copy; {{year}}
      <a href="{{siteUrl}}" style="color: #9e9e9e; text-decoration: underline;">{{siteName}}</a>
    </p>
  </td>
</tr>
