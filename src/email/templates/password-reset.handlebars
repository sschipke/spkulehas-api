<h1 class="email-heading">Password Reset</h1>

<p class="email-text">
  Please use the button below to reset your password.
</p>

{{> button href=url label="Reset Password"}}

{{> info-box
  content=(concat "<strong>NOTE:</strong> This link will expire <strong>" expiration "</strong> Mountain Time.")
}}

<p class="email-text">
  If the button does not work, copy and paste this link into your browser:
  <br />
  <a class="email-link" href="{{url}}">{{url}}</a>
</p>
