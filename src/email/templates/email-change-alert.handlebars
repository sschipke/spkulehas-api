<h1 class="email-heading">Your Email Has Changed</h1>

{{> info-box
  accentColor="#880e4f"
  backgroundColor="#fce4ec"
  content="Your account email address was recently updated. If you did not request this change, contact an administrator immediately."
}}

<p class="email-text">
  Your email has been updated from
  <strong>{{oldEmail}}</strong>
  to
  <strong>{{newEmail}}</strong>.
</p>

{{#if wasAdmin}}
  <p class="email-text">
    This change was made by <strong>{{admin.name}}</strong>.
  </p>
{{/if}}

<p class="email-text">
  If this change is incorrect, please contact the admin at
  <a class="email-link" href="mailto:{{contactEmail}}">{{contactEmail}}</a>.
</p>
