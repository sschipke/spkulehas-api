<h1 class="email-heading">Reservation Canceled</h1>

<p class="email-text">
  The reservation for <strong>{{title}}</strong> beginning on
  <strong>{{startDate}}</strong>
  and ending
  <strong>{{endDate}}</strong>
  has been canceled.
</p>

{{> button href=url label="View Calendar"}}

<p class="email-text">
  If the button does not work, copy and paste this link into your browser:
  <br />
  <a class="email-link" href="{{url}}">{{url}}</a>
</p>
