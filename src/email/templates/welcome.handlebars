<h1 class="email-heading">Welcome, {{user.profile.name}}!</h1>

<p class="email-text">
  Hello {{user.profile.name}}. Welcome to the SpKuLeHaS app. We have your email
  as <strong>{{user.email}}</strong>.
</p>

{{> info-box
  content=(concat "Your temporary password is: <strong>" user.password "</strong>")
}}

{{> button href=loginUrl label="Sign In"}}

<p class="email-text">
  If the button does not work, copy and paste this link into your browser:
  <br />
  <a class="email-link" href="{{loginUrl}}">{{loginUrl}}</a>
</p>

{{> info-box
  content="<strong>Once you have logged in for the first time, we recommend changing your password.</strong>"
}}
