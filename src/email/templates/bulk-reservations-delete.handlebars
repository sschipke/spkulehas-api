<h1 class="email-heading">Bulk Reservation Deletion</h1>

<p class="email-text">
  On {{date}},
  <strong>{{numberOfReservations}}</strong>
  reservation(s) were deleted from the
  <strong>{{environment}}</strong>
  API.
</p>

{{#if deletedReservations}}
  <table
    role="presentation"
    width="100%"
    cellspacing="0"
    cellpadding="0"
    border="0"
    style="margin: 16px 0; border: 1px solid #e0e0e0;"
  >
    <tr>
      <td style="padding: 12px 16px; background-color: #fafafa; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-weight: 700; color: #212121;">
        Deleted Reservations
      </td>
    </tr>
    {{#each deletedReservations}}
      <tr>
        <td style="padding: 12px 16px; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 14px; line-height: 1.6; color: #424242; border-top: 1px solid #e0e0e0;">
          <strong>{{title}}</strong><br />
          ID: {{id}}<br />
          {{start}} – {{end}}
          {{#if notes}}
            <br />Notes: {{notes}}
          {{/if}}
        </td>
      </tr>
    {{/each}}
  </table>
{{else}}
  {{> info-box content="<strong>NO</strong> reservations were deleted."}}
{{/if}}
