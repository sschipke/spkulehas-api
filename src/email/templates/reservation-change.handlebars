<h1 class="email-heading">Reservation Change</h1>

<p class="email-text">
  A reservation has been updated. Here is what changed:
</p>

<table
  role="presentation"
  width="100%"
  cellspacing="0"
  cellpadding="0"
  border="0"
  style="margin: 16px 0; border: 1px solid #e0e0e0;"
>
  <tr>
    <td style="padding: 12px 16px; background-color: #fafafa; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-weight: 700; color: #212121; width: 50%;">
      Previous
    </td>
    <td style="padding: 12px 16px; background-color: #fafafa; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-weight: 700; color: #212121; width: 50%;">
      Updated
    </td>
  </tr>
  <tr>
    <td style="padding: 12px 16px; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 14px; line-height: 1.6; color: #424242; vertical-align: top;">
      <strong>{{previousMember.name}}</strong><br />
      {{oldReservation.start}} – {{oldReservation.end}}
    </td>
    <td style="padding: 12px 16px; font-family: Roboto, Helvetica, Arial, sans-serif; font-size: 14px; line-height: 1.6; color: #424242; vertical-align: top;">
      <strong>{{currentMember.name}}</strong><br />
      {{newReservation.start}} – {{newReservation.end}}
    </td>
  </tr>
</table>

{{> button href=viewReservationUrl label="View Reservation"}}

<p class="email-text">
  This change was made by <strong>{{admin.name}}</strong>
  (<a class="email-link" href="mailto:{{admin.email}}">{{admin.email}}</a>).
  If this was done in error, please contact them.
</p>
