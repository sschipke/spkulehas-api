<h1 class="email-heading">Status Change</h1>

<p class="email-text">
  Hey {{newProfile.name}}, your status as a member has been updated from
  <strong>{{oldProfile.status}}</strong>
  to
  <strong>{{newProfile.status}}</strong>.
</p>

{{#if isShareholder}}
  {{> info-box
    content="<strong>Congratulations on becoming a shareholder!</strong>"
  }}
{{/if}}

<p class="email-text">
  This change was made by <strong>{{admin.name}}</strong>.
  If this information is not correct, please contact an administrator.
</p>
