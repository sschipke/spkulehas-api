<h1 class="email-heading">New Member Created</h1>

{{> info-box
  accentColor="#880e4f"
  backgroundColor="#fce4ec"
  content="A new member account was created and their welcome email has been sent."
}}

<p class="email-text">
  <strong>Name:</strong> {{user.name}}<br />
  <strong>Email:</strong> {{user.email}}
</p>

<p class="email-text">
  Added by <strong>{{admin.name}}</strong>
  (<a class="email-link" href="mailto:{{admin.email}}">{{admin.email}}</a>)
  on <strong>{{date}}</strong>.
</p>
