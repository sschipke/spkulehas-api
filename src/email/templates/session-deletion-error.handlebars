<h1 class="email-heading">Session Deletion Error</h1>

{{> info-box
  accentColor="#880e4f"
  backgroundColor="#fce4ec"
  content="An error occurred while deleting old and invalid sessions."
}}

<p class="email-text">
  Date: <strong>{{date}}</strong><br />
  Environment: <strong>{{environment}}</strong>
</p>

<p class="email-text">
  <strong>Error details:</strong><br />
  {{errorMessage}}
</p>
