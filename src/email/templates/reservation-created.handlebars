<h1 class="email-heading">Reservation Created</h1>

<p class="email-text">
  A reservation for <strong>{{currentMember.name}}</strong> beginning on
  <strong>{{reservation.start}}</strong>
  and ending
  <strong>{{reservation.end}}</strong>
  has been created.
</p>

{{> button href=viewReservationUrl label="View Reservation"}}

<p class="email-text">
  If the button does not work, copy and paste this link into your browser:
  <br />
  <a class="email-link" href="{{viewReservationUrl}}">{{viewReservationUrl}}</a>
</p>
